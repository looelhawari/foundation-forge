# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cpc_qatar

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production_12345
JWT_EXPIRES_IN=24h

# Admin Default Credentials (for initial setup only)
ADMIN_EMAIL=admin@cpcqatar.com
ADMIN_PASSWORD=Admin@123456

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
FRONTEND_URL=http://localhost:8080

# Email Configuration (SMTP)
# For Gmail: Enable "Less secure app access" or use App Password
# For production: Use a professional email service like SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password


